package taffy.compute.float;

import taffy.geometry.Point;
import taffy.geometry.Size;
import taffy.style.Clear;
import taffy.style.Direction;
import taffy.style.FloatDirection;
import taffy.util.Sys;
import taffy.util.OptionalFloat;

/**
 * A non-overlapping horizontal segment of the Block Formatting Context container
 */
private class Segment {

    /** The vertical start of the segment */
    public var yStart:Float;

    /** The vertical end of the segment */
    public var yEnd:Float;

    /** Left inset (slot 0) and right inset (slot 1) */
    public final insets:Array<Float>;

    /**
     * Whether a float actually occupies the left (slot 0) / right (slot 1) inset.
     * The insets of a segment created for a float are seeded with the float's containing
     * block insets on both sides, so a non-zero inset alone does not imply a float.
     */
    public final hasFloat:Array<Bool>;

    public function new(yStart:Float, yEnd:Float, insetLeft:Float, insetRight:Float, hasFloatLeft:Bool, hasFloatRight:Bool) {
        this.yStart = yStart;
        this.yEnd = yEnd;
        this.insets = [insetLeft, insetRight];
        this.hasFloat = [hasFloatLeft, hasFloatRight];
    }

    /** Whether the segment can fit the passed floated box (in the horizontal axis) */
    public inline function fitsFloatWidth(floatedBox:Size, direction:FloatDirection, bfcWidth:Float, cbInsets:Array<Float>):Bool {
        return FloatContext.floatFitsHorizontally(floatedBox.width, direction, bfcWidth, insets[0], insets[1], cbInsets);
    }

}

/**
 * Helper type for placing a single floated box.
 *
 * Given a pinned starting y position, this type helps determine if there is any x position
 * such that there is sufficient horizontal space for the box accross it's entire height.
 */
private class FloatFitter {

    /** The overall width of the Block Formatting Context */
    final bfcWidth:Float;

    /** The total height of the set of segments currently being considered */
    var slotHeight:Float;

    /** The union of the float insets of the set of segments currently being considered (left) */
    var floatInsetLeft:Float = 0.0;

    /** The union of the float insets of the set of segments currently being considered (right) */
    var floatInsetRight:Float = 0.0;

    /** The insets of the box's containing block from the edges of the Block Formatting Context */
    final cbInsets:Array<Float>;

    public inline function new(bfcWidth:Float, slotHeight:Float, cbInsets:Array<Float>) {
        this.bfcWidth = bfcWidth;
        this.slotHeight = slotHeight;
        this.cbInsets = cbInsets;
    }

    /** Union the insets of another segment. This is a "max" of the insets on each side. */
    public inline function unionInsets(insets:Array<Float>):Void {
        floatInsetLeft = Sys.f32Max(floatInsetLeft, insets[0]);
        floatInsetRight = Sys.f32Max(floatInsetRight, insets[1]);
    }

    /** The inset from the edge of the BFC (on the side the box is floated towards) that the box would be placed at */
    public inline function placedInset(direction:FloatDirection):Float {
        return direction == FloatDirection.Left ? Sys.f32Max(floatInsetLeft, cbInsets[0]) : Sys.f32Max(floatInsetRight, cbInsets[1]);
    }

    /** Given the currently accounted for insets, check whether there is an x position such that the box fits horizontally. */
    public inline function fitsHorizontally(width:Float, direction:FloatDirection):Bool {
        return FloatContext.floatFitsHorizontally(width, direction, bfcWidth, floatInsetLeft, floatInsetRight, cbInsets);
    }

    /** Add the height of another segment. */
    public inline function addHeight(height:Float):Void {
        slotHeight += height;
    }

    /** Given the currently accounted for height, check whether the box fits vertically */
    public inline function fitsVertically(height:Float):Bool {
        return slotHeight >= height;
    }

}

/**
 * A context for placing floated boxes (computes the position of floats in a block formatting context).
 *
 * Here are the precise rules that govern the behavior of floats (https://www.w3.org/TR/CSS22/visuren.html#floats):
 *
 * 1. The left outer edge of a left-floating box may not be to the left of the left edge of its containing block. An analogous rule
 *    holds for right-floating elements.
 * 2. If the current box is left-floating, and there are any left-floating boxes generated by elements earlier in the source document,
 *    then for each such earlier box, either the left outer edge of the current box must be to the right of the right outer edge of the earlier box,
 *    or its top must be lower than the bottom of the earlier box. Analogous rules hold for right-floating boxes.
 * 3. The right outer edge of a left-floating box may not be to the right of the left outer edge of any right-floating box that is next to it.
 * 4. A floating box's outer top may not be higher than the top of its containing block.
 * 5. The outer top of a floating box may not be higher than the outer top of any block or floated box generated by an element earlier in the source document.
 * 6. The outer top of an element's floating box may not be higher than the top of any line-box containing a box generated by an element earlier in the source document.
 * 7. A left-floating box that has another left-floating box to its left may not have its right outer edge to the right of its containing block's right edge.
 * 8. A floating box must be placed as high as possible.
 * 9. A left-floating box must be put as far to the left as possible, a right-floating box as far to the right as possible.
 */
class FloatContext {

    /**
     * Tolerance used when checking whether a box fits in a horizontal space, to absorb rounding errors
     * (e.g. percentage widths and margins that sum to exactly 100% may otherwise exceed the container width and spuriously wrap)
     */
    public static inline final FIT_TOLERANCE:Float = 0.0010000000474974513; // 0.001 in f32

    /** The available space constraint that applies to the root Block Formatting Context */
    var availableWidth:Float = 0.0;

    /** Whether the float context contains any floats */
    var hasFloatsFlag:Bool = false;

    /** A list of left-floated boxes within the context */
    final leftFloatsList:Array<PlacedFloatedBox> = [];

    /** A list of right-floated boxes within the context */
    final rightFloatsList:Array<PlacedFloatedBox> = [];

    /** A list of non-overlapping horizontal "segments" within the context. Each segment has the same available width for it's entire height. */
    final segments:Array<Segment> = [];

    /** A closed-open range indicating which segment the last placed float was placed (on each side): start / end of left and right */
    final lastPlacedFloatsStart:Array<Int> = [0, 0];
    final lastPlacedFloatsEnd:Array<Int> = [0, 0];

    /** The bottom (y + height) of the lowest float placed on each side, including zero-sized floats */
    final clearBottoms:Array<OptionalFloat> = [OptionalFloat.NONE, OptionalFloat.NONE];

    /** The topmost y position allowed for a new float (CSS2 float rule 5), including the tops of zero-sized floats */
    var floatCeiling:OptionalFloat = OptionalFloat.NONE;

    /** Create a new empty `FloatContext` */
    public function new() {}

    /** Empty the context, as a new one (contexts are reused between layout calls) */
    public function reset():Void {
        availableWidth = 0.0;
        hasFloatsFlag = false;
        leftFloatsList.resize(0);
        rightFloatsList.resize(0);
        segments.resize(0);
        lastPlacedFloatsStart[0] = 0;
        lastPlacedFloatsStart[1] = 0;
        lastPlacedFloatsEnd[0] = 0;
        lastPlacedFloatsEnd[1] = 0;
        clearBottoms[0] = OptionalFloat.NONE;
        clearBottoms[1] = OptionalFloat.NONE;
        floatCeiling = OptionalFloat.NONE;
    }

    /** Create a copy of this context */
    public function clone():FloatContext {
        final c = new FloatContext();
        c.availableWidth = availableWidth;
        c.hasFloatsFlag = hasFloatsFlag;
        for (f in leftFloatsList)
            c.leftFloatsList.push(new PlacedFloatedBox(f.width, f.height, f.xInset, f.y));
        for (f in rightFloatsList)
            c.rightFloatsList.push(new PlacedFloatedBox(f.width, f.height, f.xInset, f.y));
        for (s in segments)
            c.segments.push(new Segment(s.yStart, s.yEnd, s.insets[0], s.insets[1], s.hasFloat[0], s.hasFloat[1]));
        c.lastPlacedFloatsStart[0] = lastPlacedFloatsStart[0];
        c.lastPlacedFloatsStart[1] = lastPlacedFloatsStart[1];
        c.lastPlacedFloatsEnd[0] = lastPlacedFloatsEnd[0];
        c.lastPlacedFloatsEnd[1] = lastPlacedFloatsEnd[1];
        c.clearBottoms[0] = clearBottoms[0];
        c.clearBottoms[1] = clearBottoms[1];
        c.floatCeiling = floatCeiling;
        return c;
    }

    /**
     * Whether a floated box of the given width fits horizontally given the float insets and containing block insets that apply to it.
     *
     * A float is normally placed at the further-in of the float edge and the containing block
     * edge on the side it is floated towards (its "lead" side). From that position it must:
     *   - not overlap any float on the opposite ("trail") side (CSS2 9.5.1 rule 3), and
     *   - not extend past the containing block's trail edge if there is a float on its lead side (rule 7).
     */
    public static function floatFitsHorizontally(width:Float, direction:FloatDirection, bfcWidth:Float, floatInsetLeft:Float, floatInsetRight:Float, cbInsets:Array<Float>):Bool {
        final lead:Int = direction;
        final trail = 1 - lead;
        final floatLead = lead == 0 ? floatInsetLeft : floatInsetRight;
        final floatTrail = lead == 0 ? floatInsetRight : floatInsetLeft;
        final xInset = Sys.f32Max(floatLead, cbInsets[lead]);
        final fitsOppositeFloats = floatTrail == 0.0 || xInset + width <= bfcWidth - floatTrail + FIT_TOLERANCE;
        final fitsContainingBlock = floatLead == 0.0 || xInset + width <= bfcWidth - cbInsets[trail] + FIT_TOLERANCE;
        return fitsOppositeFloats && fitsContainingBlock;
    }

    /** Whether the float context contains any floats */
    public inline function hasFloats():Bool {
        return hasFloatsFlag;
    }

    /** Whether the float context contains any floats that extend to or below minY */
    public inline function hasActiveFloats(minY:Float):Bool {
        return hasFloatsFlag && (segments.length > 0 ? segments[segments.length - 1].yEnd : 0.0) > minY;
    }

    /** Set the width of the `FloatContext` */
    public inline function setWidth(availableWidth:Float):Void {
        this.availableWidth = availableWidth;
    }

    /** Returns the placed left floats */
    public inline function leftFloats():Array<PlacedFloatedBox> {
        return leftFloatsList;
    }

    /** Returns the placed right floats */
    public inline function rightFloats():Array<PlacedFloatedBox> {
        return rightFloatsList;
    }

    /** Divide a segment into two segments so that a new float can have its vertical start and end at exact segment boundaries */
    function subdivideSegment(idx:Int, divideAtY:Float):Void {
        final oldSegment = segments[idx];
        final newSegment = new Segment(divideAtY, oldSegment.yEnd, oldSegment.insets[0], oldSegment.insets[1], oldSegment.hasFloat[0], oldSegment.hasFloat[1]);
        if (!(divideAtY >= oldSegment.yStart && divideAtY < oldSegment.yEnd) || oldSegment.yStart == divideAtY) {
            throw 'subdivideSegment: invalid division at $divideAtY';
        }
        oldSegment.yEnd = divideAtY;
        segments.insert(idx + 1, newSegment);
    }

    /** Update the last placed float start and end values */
    function updateLastPlacedFloat(direction:FloatDirection, placementStart:Int, placementEnd:Int):Void {
        final slot:Int = direction;
        lastPlacedFloatsStart[slot] = Sys.imax(lastPlacedFloatsStart[slot], placementStart);
        lastPlacedFloatsEnd[slot] = Sys.imax(lastPlacedFloatsEnd[slot], placementEnd);
    }

    /** Position a floated box with the context, returning the (x, y) coordinates */
    public function placeFloatedBox(floatedBox:Size, minY:Float, containingBlockInsets:Array<Float>, direction:FloatDirection, clear:Clear):Point {
        hasFloatsFlag = true;
        final placedFloatedBox = placeFloatedBoxInner(floatedBox, minY, containingBlockInsets, direction, clear);
        final slot:Int = direction;
        final bottom = placedFloatedBox.y + placedFloatedBox.height;
        final prevBottom = clearBottoms[slot];
        clearBottoms[slot] = prevBottom.isNone() ? OptionalFloat.some(bottom) : OptionalFloat.some(Sys.f32Max(prevBottom.unwrap(), bottom));
        final y = placedFloatedBox.y;
        floatCeiling = floatCeiling.isNone() ? OptionalFloat.some(y) : OptionalFloat.some(Sys.f32Max(floatCeiling.unwrap(), y));
        final xInset = placedFloatedBox.xInset;
        if (direction == FloatDirection.Left) {
            leftFloatsList.push(placedFloatedBox);
            return new Point(xInset, y);
        }
        else {
            rightFloatsList.push(placedFloatedBox);
            return new Point(availableWidth - xInset - floatedBox.width, y);
        }
    }

    /** Index of the first segment at or after `from` whose end is below `minY`, or -1 */
    inline function findSegment(from:Int, minY:Float):Int {
        var result = -1;
        if (from <= segments.length) {
            for (i in from...segments.length) {
                if (segments[i].yEnd > minY) {
                    result = i;
                    break;
                }
            }
        }
        return result;
    }

    /** Inner implementation of float placement */
    function placeFloatedBoxInner(floatedBox:Size, minY:Float, containingBlockInsets:Array<Float>, direction:FloatDirection, clear:Clear):PlacedFloatedBox {
        final slot:Int = direction;

        // Floats (including zero-sized floats) that occupy no segment still constrain the
        // position of later boxes: rule 5 and `clear`
        final threshold = clearedThreshold(clear);
        minY = Sys.f32Max(Sys.f32Max(minY, floatCeiling.isSome() ? floatCeiling.unwrap() : Math.NEGATIVE_INFINITY), threshold.isSome() ? threshold.unwrap() : Math.NEGATIVE_INFINITY);

        // Ensure that float:
        //    - Starts at or after the last placed float in either direction (CSS2 float rule 5)
        //    - Respects "clear"
        final floatStart = Sys.imax(lastPlacedFloatsStart[0], lastPlacedFloatsStart[1]);
        final hwm = switch clear {
            case Clear.Left: Sys.imax(floatStart, lastPlacedFloatsEnd[0] + 1);
            case Clear.Right: Sys.imax(floatStart, lastPlacedFloatsEnd[1] + 1);
            case Clear.Both: Sys.imax(lastPlacedFloatsEnd[0], lastPlacedFloatsEnd[1]) + 1;
            case Clear.None: floatStart;
        }

        // Ensure that float is placed in a segment at or below "minY"
        var startIdx = findSegment(hwm, minY);
        if (startIdx == -1)
            startIdx = segments.length;
        var startY = minY;
        var endIdx = startIdx;

        // Loop over remaining segments, trying to place the float in a position that has space to accomodate it.
        var start:Int = -1;
        var end:Int = -1;
        var placedInset:Float = 0.0;
        while (true) {
            // Start segment does not exist: no existing segment can accomodate the float so we must create a new
            // segment below all existing segments.
            if (startIdx >= segments.length) {
                start = -1;
                end = -1;
                placedInset = containingBlockInsets[slot];
                break;
            }
            final startSegment = segments[startIdx];

            // Candidate start segment doesn't have (horizontal) space for the float: retry with the next segment
            if (!startSegment.fitsFloatWidth(floatedBox, direction, availableWidth, containingBlockInsets)) {
                startIdx++;
                endIdx = Sys.imax(endIdx, startIdx);
                continue;
            }

            startY = Sys.f32Max(startY, startSegment.yStart);
            final availableHeight = startSegment.yEnd - startY;
            final fitter = new FloatFitter(availableWidth, availableHeight, containingBlockInsets);
            fitter.unionInsets(startSegment.insets);

            // Pinning the start segment, loop over segments starting with the start segment to find the end segment
            var found = false;
            var retryOuter = false;
            while (true) {
                // End segment does not exist: create a new segment below all existing segments
                if (endIdx >= segments.length) {
                    start = startIdx;
                    end = -1;
                    placedInset = fitter.placedInset(direction);
                    found = true;
                    break;
                }
                final endSegment = segments[endIdx];

                // Check horizontal fit
                fitter.unionInsets(endSegment.insets);
                if (!fitter.fitsHorizontally(floatedBox.width, direction)) {
                    startIdx++;
                    endIdx = Sys.imax(endIdx, startIdx);
                    retryOuter = true;
                    break;
                }

                // Check vertical fit
                if (endIdx != startIdx) {
                    fitter.addHeight(endSegment.yEnd - endSegment.yStart);
                }
                if (!fitter.fitsVertically(floatedBox.height)) {
                    endIdx++;
                    continue;
                }

                start = startIdx;
                end = endIdx;
                placedInset = fitter.placedInset(direction);
                found = true;
                break;
            }
            if (retryOuter)
                continue;
            if (found)
                break;
        }

        // Short-circuit for zero-height boxes. Zero-width boxes are still recorded in segments.
        if (floatedBox.height == 0.0) {
            return new PlacedFloatedBox(floatedBox.width, floatedBox.height, placedInset, startY);
        }

        // Handle case where floated box is placed after all existing segments
        if (start == -1) {
            final lastYEnd = segments.length > 0 ? segments[segments.length - 1].yEnd : 0.0;
            if (startY > lastYEnd) {
                segments.push(new Segment(lastYEnd, startY, 0.0, 0.0, false, false));
            }
            final sy = Sys.f32Max(lastYEnd, startY);
            final insetLeft = containingBlockInsets[0] + (slot == 0 ? floatedBox.width : 0.0);
            final insetRight = containingBlockInsets[1] + (slot == 1 ? floatedBox.width : 0.0);
            segments.push(new Segment(sy, sy + floatedBox.height, insetLeft, insetRight, slot == 0, slot == 1));
            // Update lastPlacedFloat
            final si = segments.length - 1;
            updateLastPlacedFloat(direction, si, si + 1);
            return new PlacedFloatedBox(floatedBox.width, floatedBox.height, containingBlockInsets[slot], sy);
        }

        // Else the index of the segment that the start of the floating box is placed in
        var si = start;

        // If the floated box doesn't start at the exact same y-offset as the segment it starts in, then
        // subdivide that segment into two segments at the y-offset that the floated box starts at
        if (startY != segments[si].yStart) {
            subdivideSegment(si, startY);
            si++;
            if (end != -1)
                end++;
        }

        var ei:Int;
        if (end == -1) {
            final lastYEnd = segments.length > 0 ? segments[segments.length - 1].yEnd : 0.0;
            if (minY > lastYEnd) {
                segments.push(new Segment(lastYEnd, minY, 0.0, 0.0, false, false));
            }
            ei = segments.length - 1;
        }
        else {
            ei = end;
            final endY = startY + floatedBox.height;
            // Due to floating point imprecision, `endY` may coincide with (or fall before)
            // the start of the end segment: walk back to the segment that actually contains `endY`.
            while (ei > si && endY <= segments[ei].yStart) {
                ei--;
            }
            // Only subdivide if `endY` falls strictly within the segment.
            if (segments[ei].yStart < endY && endY < segments[ei].yEnd) {
                subdivideSegment(ei, endY);
            }
        }

        // Update inset for the range of segments that the float is placed in
        final placedInsetPlusWidth = placedInset + floatedBox.width;
        for (i in si...(ei + 1)) {
            final segment = segments[i];
            segment.insets[slot] = placedInsetPlusWidth;
            segment.hasFloat[slot] = true;
        }

        // Update lastPlacedFloat
        updateLastPlacedFloat(direction, si, ei + 1);

        return new PlacedFloatedBox(floatedBox.width, floatedBox.height, placedInset, startY);
    }

    /** Get the end segment of the last float on side(s) specified by the clear parameter, or -1 */
    function clearedSegment(clear:Clear):Int {
        final leftEnd = lastPlacedFloatsEnd[0];
        final rightEnd = lastPlacedFloatsEnd[1];
        return switch clear {
            case Clear.Left if (leftEnd > 0): leftEnd;
            case Clear.Right if (rightEnd > 0): rightEnd;
            case Clear.Both if (leftEnd > 0 || rightEnd > 0): Sys.imax(leftEnd, rightEnd);
            case _: -1;
        }
    }

    /** Get the bottom of lowest relevant float for the specific clear property */
    public function clearedThreshold(clear:Clear):OptionalFloat {
        return switch clear {
            case Clear.Left: clearBottoms[0];
            case Clear.Right: clearBottoms[1];
            case Clear.Both:
                final l = clearBottoms[0];
                final r = clearBottoms[1];
                if (l.isSome() && r.isSome()) OptionalFloat.some(Sys.f32Max(l.unwrap(), r.unwrap())) else (l.isSome() ? l : r);
            case Clear.None: OptionalFloat.NONE;
        }
    }

    /** Search for a space suitable for laying out non-floated content into (`after` is a segment id or -1) */
    public function findContentSlot(minY:Float, containingBlockInsets:Array<Float>, clear:Clear, after:Int):ContentSlot {
        if (!hasActiveFloats(minY)) {
            return new ContentSlot(-1, containingBlockInsets[0], minY, availableWidth - containingBlockInsets[0] - containingBlockInsets[1], Math.POSITIVE_INFINITY);
        }

        // Clearance clears past the bottom of floats on the relevant side, including zero-sized floats
        final threshold = clearedThreshold(clear);
        minY = Sys.f32Max(minY, threshold.isSome() ? threshold.unwrap() : Math.NEGATIVE_INFINITY);

        // The min starting segment index
        final atLeast = after != -1 ? after + 1 : 0;
        final cleared = clearedSegment(clear);
        final hwm = Sys.imax(atLeast, cleared != -1 ? cleared + 1 : 0);
        var startIdx = findSegment(hwm, minY);
        if (startIdx == -1)
            startIdx = segments.length;

        if (startIdx < segments.length) {
            final segment = segments[startIdx];
            final insetLeft = Sys.f32Max(segment.insets[0], containingBlockInsets[0]);
            final insetRight = Sys.f32Max(segment.insets[1], containingBlockInsets[1]);
            return new ContentSlot(startIdx, insetLeft, Sys.f32Max(segment.yStart, minY), availableWidth - insetLeft - insetRight, Math.POSITIVE_INFINITY);
        }
        return new ContentSlot(-1, containingBlockInsets[0], minY, availableWidth - containingBlockInsets[0] - containingBlockInsets[1], Math.POSITIVE_INFINITY);
    }

    /**
     * Search for a space suitable for laying out a box that establishes an independent
     * formatting context (whose border box must not overlap floats). `after` is a segment id or -1.
     *
     * The box's margins are resolved against the containing block's content edges. When there
     * are floats beside the box:
     *   - The leading margin positions the border box's leading edge, but may be partially or fully
     *     "absorbed" by a float on the leading side, and a negative leading margin does not move the
     *     border edge past the float edge.
     *   - The trailing margin is subtracted from the width an auto width resolves to (except for any
     *     part of it that overlaps a float on the trailing side).
     * When there are no floats beside the box, its (possibly negative) margins apply as usual.
     */
    public function findBfcSlot(minY:Float, containingBlockInsets:Array<Float>, margins:Array<Float>, direction:Direction, clear:Clear, after:Int):BfcSlot {
        final marginInset0 = containingBlockInsets[0] + margins[0];
        final marginInset1 = containingBlockInsets[1] + margins[1];
        final noFloatWidth = availableWidth - marginInset0 - marginInset1;

        if (!hasActiveFloats(minY)) {
            return new BfcSlot(-1, marginInset0, minY, noFloatWidth, noFloatWidth);
        }

        // Clearance clears past the bottom of floats on the relevant side, including zero-sized floats
        final threshold = clearedThreshold(clear);
        minY = Sys.f32Max(minY, threshold.isSome() ? threshold.unwrap() : Math.NEGATIVE_INFINITY);

        // The min starting segment index
        final atLeast = after != -1 ? after + 1 : 0;
        final cleared = clearedSegment(clear);
        final hwm = Sys.imax(atLeast, cleared != -1 ? cleared + 1 : 0);
        var startIdx = findSegment(hwm, minY);
        if (startIdx == -1)
            startIdx = segments.length;

        if (startIdx < segments.length) {
            final segment = segments[startIdx];
            final marginInsets = [marginInset0, marginInset1];
            final lead = direction == Direction.Ltr ? 0 : 1;
            final trail = 1 - lead;
            final hasLeadFloat = segment.hasFloat[lead];
            final hasTrailFloat = segment.hasFloat[trail];
            final fitInsets = [0.0, 0.0];
            final stretchInsets = [0.0, 0.0];
            fitInsets[lead] = hasLeadFloat ? Sys.f32Max(segment.insets[lead], marginInsets[lead]) : marginInsets[lead];
            stretchInsets[lead] = fitInsets[lead];
            // A positive trailing margin may overflow the containing block edge (it does
            // not affect fit), but a negative one widens the space for the border box
            fitInsets[trail] = hasTrailFloat
                ? Sys.f32Max(segment.insets[trail], containingBlockInsets[trail])
                : Sys.f32Min(marginInsets[trail], containingBlockInsets[trail]);
            stretchInsets[trail] = hasTrailFloat ? Sys.f32Max(segment.insets[trail], marginInsets[trail]) : marginInsets[trail];
            return new BfcSlot(
                startIdx,
                fitInsets[0],
                Sys.f32Max(segment.yStart, minY),
                availableWidth - fitInsets[0] - fitInsets[1],
                availableWidth - stretchInsets[0] - stretchInsets[1]
            );
        }

        // Below all floats
        final y = Sys.f32Max(segments.length > 0 ? segments[segments.length - 1].yEnd : minY, minY);
        return new BfcSlot(-1, marginInset0, y, noFloatWidth, noFloatWidth);
    }

}
