package taffy.compute.grid;

import taffy.geometry.AbsoluteAxis;
import taffy.style.GridTemplateComponent;
import taffy.style.LengthPercentage;
import taffy.style.RepetitionCount;
import taffy.style.Style;
import taffy.style.TrackSizingFunction;
import taffy.util.MaybeMath;
import taffy.util.Sys;
import taffy.util.OptionalFloat;

/**
 * The auto-repeat fit strategy to use
 */
enum abstract AutoRepeatStrategy(Int) {

    /**
     * If the grid container has a definite size or max size in the relevant axis:
     *   - then the number of repetitions is the largest possible positive integer that does not cause the grid to overflow the content
     *     box of its grid container.
     */
    var MaxRepetitionsThatDoNotOverflow = 0;

    /**
     * Otherwise, if the grid container has a definite min size in the relevant axis:
     *   - then the number of repetitions is the smallest possible positive integer that fulfills that minimum requirement
     */
    var MinRepetitionsThatDoOverflow = 1;

}

/**
 * The result of `computeExplicitGridSizeInAxis`: the number of auto repetitions and the number of explicit tracks
 */
class ExplicitGridSize {

    /** The number of repetitions of the auto-repeated track list */
    public final autoRepetitionCount:Int;

    /** The number of tracks in the explicit grid template */
    public final trackCount:Int;

    public inline function new(autoRepetitionCount:Int, trackCount:Int) {
        this.autoRepetitionCount = autoRepetitionCount;
        this.trackCount = trackCount;
    }

}

/**
 * Helper functions for initialising GridTrack's from styles
 * This mainly consists of evaluating GridAutoTracks
 */
class ExplicitGrid {

    static final ZERO_SIZE:ExplicitGridSize = new ExplicitGridSize(0, 0);

    /**
     * `u32::MAX`, exact. An inline constant so that the `F32` macro leaves it
     * alone: these helpers emulate integer casts, not f32 arithmetic (as an
     * f32 literal it would round to 4294967296).
     */
    static inline final U32_MAX:Float = 4294967295.0;

    /** Saturating `u32` to `u16`-ish clamp used for track counts */
    static inline function u32Clamp(value:Float):Float {
        return value < 0 ? 0 : (value > U32_MAX ? U32_MAX : value);
    }

    /** Compute the number of rows and columns in the explicit grid */
    public static function computeExplicitGridSizeInAxis(style:Style, autoFitContainerSize:OptionalFloat, autoFitStrategy:AutoRepeatStrategy,
            axis:AbsoluteAxis):ExplicitGridSize {
        final template = style.gridTemplateTracks(axis);

        // If template contains no tracks, then there are trivially zero explicit tracks
        final trackCount = template.length;
        if (trackCount == 0)
            return ZERO_SIZE;

        // If there are any repetitions that contains no tracks, then the whole definition should be considered invalid
        // and we default to no explicit tracks
        for (trackDef in template) {
            switch trackDef {
                case Repeat(repeat) if (repeat.trackCount() == 0):
                    return ZERO_SIZE;
                case _:
            }
        }

        // Compute that number of track generated by single track definition and repetitions with a fixed repetition count
        // (clamping to the maximum track limit to prevent arithmetic overflow)
        var nonAutoRepeatingTrackCountF = 0.0;
        var autoRepetitionCount = 0;
        var allTrackDefsHaveFixedComponent = true;
        for (trackDef in template) {
            switch trackDef {
                case Single(sizingFunction):
                    nonAutoRepeatingTrackCountF += 1;
                    if (!sizingFunction.hasFixedComponent())
                        allTrackDefsHaveFixedComponent = false;
                case Repeat(repeat):
                    switch repeat.count {
                        case Count(count):
                            nonAutoRepeatingTrackCountF += count * repeat.trackCount();
                        case AutoFit | AutoFill:
                            autoRepetitionCount++;
                    }
                    for (sizingFunction in repeat.tracks) {
                        if (!sizingFunction.hasFixedComponent())
                            allTrackDefsHaveFixedComponent = false;
                    }
            }
        }
        final nonAutoRepeatingTrackCount:Int = nonAutoRepeatingTrackCountF > GridCoordinates.MAX_GRID_TRACKS ? GridCoordinates.MAX_GRID_TRACKS : Std.int(nonAutoRepeatingTrackCountF);

        final templateIsValid = autoRepetitionCount == 0 || (autoRepetitionCount == 1 && allTrackDefsHaveFixedComponent);

        // If the template is invalid because it contains multiple auto-repetition definitions or it combines an auto-repetition
        // definition with non-fixed-size track sizing functions, then disregard it entirely and default to zero explicit tracks
        if (!templateIsValid)
            return ZERO_SIZE;

        // If there are no repetitions, then the number of explicit tracks is simply equal to the lengths of the track definition
        // vector (as each item in the Vec represents one track).
        if (autoRepetitionCount == 0)
            return new ExplicitGridSize(0, nonAutoRepeatingTrackCount);

        var autoRepeatInsertionPoint = 0.0;
        var repetitionDefinition:Null<taffy.style.GridTemplateRepetition> = null;
        for (def in template) {
            switch def {
                case Single(_):
                    autoRepeatInsertionPoint += 1;
                case Repeat(repeat):
                    switch repeat.count {
                        case Count(count):
                            autoRepeatInsertionPoint += count * repeat.trackCount();
                        case AutoFit | AutoFill:
                            repetitionDefinition = repeat;
                    }
            }
            if (repetitionDefinition != null)
                break;
        }
        final repetitionTrackCount = repetitionDefinition.trackCount();

        // Determine the number of repetitions
        var numRepetitions:Float = if (autoFitContainerSize.isNone()) {
            1;
        }
        else {
            final innerContainerSize:Float = autoFitContainerSize.unwrap();
            final parentSize:OptionalFloat = OptionalFloat.some(innerContainerSize);

            var nonRepeatingTrackUsedSpace = 0.0;
            for (trackDef in template) {
                switch trackDef {
                    case Single(sizingFunction):
                        nonRepeatingTrackUsedSpace += trackDefiniteValue(sizingFunction, parentSize);
                    case Repeat(repeat):
                        switch repeat.count {
                            case Count(count):
                                var sum = 0.0;
                                for (sizingFunction in repeat.tracks)
                                    sum += trackDefiniteValue(sizingFunction, parentSize);
                                nonRepeatingTrackUsedSpace += sum * count;
                            case AutoFit | AutoFill:
                        }
                }
            }
            final gapStyle:LengthPercentage = axis == Horizontal ? style.gap.width : style.gap.height;
            final gapSize = gapStyle.resolveOrZero(OptionalFloat.some(innerContainerSize));

            // Compute the amount of space that a single repetition of the repeated track list takes
            var perRepetitionTrackUsedSpace = 0.0;
            for (sizingFunction in repetitionDefinition.tracks)
                perRepetitionTrackUsedSpace += trackDefiniteValue(sizingFunction, parentSize);

            // We special case the first repetition here because the number of gaps in the first repetition
            // depends on the number of non-repeating tracks in the template
            final gapCount = nonAutoRepeatingTrackCount + repetitionTrackCount - 1;
            final firstRepetitionAndNonRepeatingTracksUsedSpace = nonRepeatingTrackUsedSpace
                + perRepetitionTrackUsedSpace
                + ((gapCount > 0 ? gapCount : 0) * gapSize);

            // If a single repetition already overflows the container then we return 1 as the repetition count
            // (the number of repetitions is floored at 1)
            if (firstRepetitionAndNonRepeatingTracksUsedSpace > innerContainerSize) {
                1;
            }
            else {
                final perRepetitionGapUsedSpace = repetitionTrackCount * gapSize;
                final perRepetitionUsedSpace = perRepetitionTrackUsedSpace + perRepetitionGapUsedSpace;
                final numRepetitionThatFit = (innerContainerSize - firstRepetitionAndNonRepeatingTracksUsedSpace) / perRepetitionUsedSpace;

                // If the container size is a preferred or maximum size:
                //   Then we return the maximum number of repetitions that fit into the container without overflowing.
                // If the container size is a minimum size:
                //   - Then we return the minimum number of repetitions required to overflow the size.
                //
                // In all cases we add the additional repetition that was already accounted for in the special-case computation above
                // Note: as-casts from f32 to u32 saturate, so a huge or infinite number of repetitions
                // (e.g. due to zero-sized tracks) resolves to u32::MAX and is clamped below
                switch autoFitStrategy {
                    case MaxRepetitionsThatDoNotOverflow:
                        u32Clamp(Sys.floor(asU32(numRepetitionThatFit)) + 1);
                    case MinRepetitionsThatDoOverflow:
                        u32Clamp(Sys.ceil(asU32(numRepetitionThatFit)) + 1);
                }
            }
        }

        // Clamp the number of repetitions based on the auto-repeat's insertion point so that tracks
        // before it are preserved and tracks after it are truncated in source order.
        // https://www.w3.org/TR/css-grid-1/#overlarge-grids
        final remainingTracks = GridCoordinates.MAX_GRID_TRACKS - autoRepeatInsertionPoint;
        final finalRepetitions:Int = if (remainingTracks <= 0) {
            0;
        }
        else {
            final maxRepetitions = Std.int((Std.int(remainingTracks) + repetitionTrackCount - 1) / repetitionTrackCount);
            numRepetitions < 1 ? 1 : (numRepetitions > maxRepetitions ? maxRepetitions : Std.int(numRepetitions));
        }

        final total = nonAutoRepeatingTrackCount + repetitionTrackCount * finalRepetitions;
        final gridTemplateTrackCount = total < GridCoordinates.MAX_GRID_TRACKS ? total : GridCoordinates.MAX_GRID_TRACKS;
        return new ExplicitGridSize(finalRepetitions, gridTemplateTrackCount);
    }

    /** Emulates a saturating `f32 as u32` cast (NaN becomes 0) */
    static inline function asU32(value:Float):Float {
        return value != value ? 0 : (value < 0 ? 0 : (value > U32_MAX ? U32_MAX : value));
    }

    /**
     * ...treating each track as its max track sizing function if that is definite or as its minimum track sizing function
     * otherwise, flooring the max track sizing function by the min track sizing function if both are definite
     */
    static function trackDefiniteValue(sizingFunction:TrackSizingFunction, parentSize:OptionalFloat):Float {
        final maxSize = sizingFunction.max.definiteValue(parentSize);
        final minSize = sizingFunction.min.definiteValue(parentSize);
        return maxSize.isSome() ? MaybeMath.maybeMaxF(maxSize.unwrap(), minSize) : minSize.unwrap();
    }

    /**
     * Resolve the track sizing functions of explicit tracks, automatically created tracks, and gutters
     * given a set of track counts and all of the relevant styles
     *
     * `matrix` is used to determine whether a track has items (for auto-fit collapsing): may be null if no track has items.
     */
    public static function initializeGridTracks(tracks:Array<GridTrack>, counts:TrackCounts, style:Style, axis:AbsoluteAxis,
            autoRepetitionCount:Int, matrix:Null<CellOccupancyMatrix>):Void {
        // Extract styles
        final trackTemplate = axis == Horizontal ? style.gridTemplateColumns : style.gridTemplateRows;
        final autoTracks = axis == Horizontal ? style.gridAutoColumns : style.gridAutoRows;
        final gap:LengthPercentage = axis == Horizontal ? style.gap.width : style.gap.height;

        // Clear vector (in case this is a re-layout), and push the initial gutter
        tracks.resize(0);
        tracks.push(GridTrack.gutter(gap));

        final autoTrackCount = autoTracks.length;

        // Create negative implicit tracks
        if (counts.negativeImplicit > 0) {
            if (autoTrackCount == 0) {
                createImplicitTracks(tracks, counts.negativeImplicit, null, 0, gap);
            }
            else {
                final offset = autoTrackCount - (counts.negativeImplicit % autoTrackCount);
                createImplicitTracks(tracks, counts.negativeImplicit, autoTracks, offset % autoTrackCount, gap);
            }
        }

        var currentTrackIndex = counts.negativeImplicit;

        // The maximum index up to which explicit tracks may be created. The explicit track count is clamped
        // to MAX_GRID_TRACKS, so track creation from the template must be truncated to match.
        final explicitTrackLimit = counts.negativeImplicit + counts.explicit;

        // Create explicit tracks
        // An explicit check against the count (rather than just relying on track_template being empty) is required here
        // because a count of zero can result from the track_template being invalid, in which case it should be ignored.
        if (counts.explicit > 0) {
            for (trackSizingFunction in trackTemplate) {
                switch trackSizingFunction {
                    case Single(sizingFunction):
                        if (currentTrackIndex < explicitTrackLimit) {
                            tracks.push(GridTrack.track(sizingFunction.minSizingFunction(), sizingFunction.maxSizingFunction()));
                            tracks.push(GridTrack.gutter(gap));
                            currentTrackIndex++;
                        }
                    case Repeat(repeat):
                        switch repeat.count {
                            case Count(count):
                                final wanted = repeat.trackCount() * count;
                                final available = explicitTrackLimit - currentTrackIndex;
                                final repeatedTrackCount = wanted < available ? wanted : available;
                                final repeatTracks = repeat.tracks;
                                for (i in 0...repeatedTrackCount) {
                                    final sizingFunction = repeatTracks[i % repeatTracks.length];
                                    tracks.push(GridTrack.track(sizingFunction.minSizingFunction(), sizingFunction.maxSizingFunction()));
                                    tracks.push(GridTrack.gutter(gap));
                                    currentTrackIndex++;
                                }
                            case AutoFit | AutoFill:
                                final isAutoFit = repeat.count.match(AutoFit);
                                final wanted = repeat.trackCount() * autoRepetitionCount;
                                final available = explicitTrackLimit - currentTrackIndex;
                                final autoRepeatedTrackCount = wanted < available ? wanted : available;
                                final repeatTracks = repeat.tracks;
                                for (i in 0...autoRepeatedTrackCount) {
                                    final trackDef = repeatTracks[i % repeatTracks.length];
                                    final track = GridTrack.track(trackDef.minSizingFunction(), trackDef.maxSizingFunction());
                                    final gutter = GridTrack.gutter(gap);

                                    // Auto-fit tracks that don't contain should be collapsed.
                                    if (isAutoFit && !trackHasItems(matrix, axis, currentTrackIndex)) {
                                        track.collapse();
                                        gutter.collapse();
                                    }

                                    tracks.push(track);
                                    tracks.push(gutter);

                                    currentTrackIndex++;
                                }

                                // Is this auto-repeat at the very end of the track list?
                                final isLast = currentTrackIndex == counts.len();

                                // When collapsing auto-fit tracks (in the loop just above), we collapse the gutter after collapsed
                                // tracks but not the gutter before. This is correct so long as there is another non-collapsed track
                                // somewhere in the track list after the collapsed track.
                                //
                                // However, if the auto-fit repeat is at the very end of the track list, then there will be no such track.
                                // In this case we need to iterate backwards through the track list until we find a non-collapsed track and
                                // collapse the gutter just after that track.
                                //
                                // As all of the other tracks and gutters we find along the way will already be collapsed, we simplify the
                                // implementation to collapsing all tracks and gutters until we find the first non-collapsed track.
                                if (isAutoFit && isLast) {
                                    var i = tracks.length - 1;
                                    while (i >= 0) {
                                        final previousTrack = tracks[i];
                                        if (previousTrack.kind == Track && !previousTrack.isCollapsed)
                                            break;
                                        previousTrack.collapse();
                                        i--;
                                    }
                                }
                        }
                }
            }
        }

        final gridAreaTracks = (counts.negativeImplicit + counts.explicit) - currentTrackIndex;

        // Create positive implicit tracks
        if (autoTrackCount == 0)
            createImplicitTracks(tracks, counts.positiveImplicit + gridAreaTracks, null, 0, gap);
        else
            createImplicitTracks(tracks, counts.positiveImplicit + gridAreaTracks, autoTracks, 0, gap);

        // Mark first and last grid lines as collapsed
        tracks[0].collapse();
        tracks[tracks.length - 1].collapse();
    }

    static inline function trackHasItems(matrix:Null<CellOccupancyMatrix>, axis:AbsoluteAxis, index:Int):Bool {
        return matrix != null && (axis == Horizontal ? matrix.columnIsOccupied(index) : matrix.rowIsOccupied(index));
    }

    /**
     * Utility function for repeating logic of creating implicit tracks.
     * Cycles through `autoTracks` starting at `startIndex` (or uses `auto` tracks if `autoTracks` is null)
     */
    static function createImplicitTracks(tracks:Array<GridTrack>, count:Int, autoTracks:Null<Array<TrackSizingFunction>>, startIndex:Int,
            gap:LengthPercentage):Void {
        var index = startIndex;
        for (_ in 0...count) {
            final trackDef = autoTracks == null ? TrackSizingFunction.AUTO : autoTracks[index % autoTracks.length];
            index++;
            tracks.push(GridTrack.track(trackDef.minSizingFunction(), trackDef.maxSizingFunction()));
            tracks.push(GridTrack.gutter(gap));
        }
    }

}
