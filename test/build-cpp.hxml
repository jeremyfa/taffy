# Builds the test runner with hxcpp (native executable in bin/cpp)
# Requires hxcpp: a local repository can be set up in this folder with
#   haxelib newrepo && haxelib dev hxcpp <path to hxcpp>
-cp ../src
-cp src
-main Main
-D analyzer-optimize
-cpp bin/cpp
--macro addGlobalMetadata('taffy', '@:build(taffy.util.F32.build())')
